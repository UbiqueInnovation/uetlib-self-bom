<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.ubique</groupId>
    <artifactId>uetlib-self-bom</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <uetlib-test.version>2.0.1</uetlib-test.version>
        <uetlib-testcontainers.version>2.0.1</uetlib-testcontainers.version>
        <uetlib-core.version>2.1.1</uetlib-core.version>
        <uetlib-storage.version>2.0.3</uetlib-storage.version>
        <uetlib-db.version>2.0.1</uetlib-db.version>
        <uetlib-geo.version>3.1.0</uetlib-geo.version>
        <uetlib-spring-cloud.version>2.2.0</uetlib-spring-cloud.version>
        <uetlib-spring-boot.version>2.1.0</uetlib-spring-boot.version>
        <uetlib-spring-boot-test.version>2.0.1</uetlib-spring-boot-test.version>
        <uetlib-storage-spring-boot.version>2.0.1</uetlib-storage-spring-boot.version>
        <uetlib-monitoring.version>2.2.0</uetlib-monitoring.version>
        <uetlib-job.version>3.2.0</uetlib-job.version>

        <uetlib-rust.version>0.1.3</uetlib-rust.version>

        <!-- Sonar & Jacoco coverage reports -->
        <sonar.coverage.module>uetlib-self-bom</sonar.coverage.module>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.basedir}/../${sonar.coverage.module}/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.projectName>${project.artifactId}</sonar.projectName>
        <sonar.projectKey>UbiqueInnovation_${sonar.projectName}</sonar.projectKey>
        <sonar.organization>ubiqueinnovation</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>${uetlib-core.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-db</artifactId>
                <version>${uetlib-db.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-geo</artifactId>
                <version>${uetlib-geo.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-geo-db</artifactId>
                <version>${uetlib-geo.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-geo-job</artifactId>
                <version>${uetlib-geo.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-job</artifactId>
                <version>${uetlib-job.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-monitoring</artifactId>
                <version>${uetlib-monitoring.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-rust-crypto-jvm</artifactId>
                <version>${uetlib-rust.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-rust-qrcode-jvm</artifactId>
                <version>${uetlib-rust.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>${uetlib-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot-validation</artifactId>
                <version>${uetlib-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot-security</artifactId>
                <version>${uetlib-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot-geo</artifactId>
                <version>${uetlib-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-cloud</artifactId>
                <version>${uetlib-spring-cloud.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-cloud-security</artifactId>
                <version>${uetlib-spring-cloud.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-storage</artifactId>
                <version>${uetlib-storage.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-storage-spring-boot</artifactId>
                <version>${uetlib-storage-spring-boot.version}</version>
            </dependency>

            <!-- Test module -->
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-test</artifactId>
                <version>${uetlib-test.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-spring-boot-test</artifactId>
                <version>${uetlib-spring-boot-test.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-mariadb</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-mongodb</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-mysql</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-postgresql</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-influxdb</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-testcontainers-redis</artifactId>
                <version>${uetlib-testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>ubique-artifactory-virtual</id>
            <name>ubique</name>
            <url>https://artifactory.ubique.ch/artifactory/ubique</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <scm>
        <url>https://github.com/UbiqueInnovation/uetlib-self-bom</url>
    </scm>
</project>
