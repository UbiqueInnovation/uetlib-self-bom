                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-geo-job</artifactId>
                <version>3.2.2</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-job</artifactId>
                <version>5.0.3</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-monitoring</artifactId>
                <version>2.4.0</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-payment</artifactId>
                <version>2.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-payment-datatrans</artifactId>
                <version>2.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-payment-postfinance</artifactId>
                <version>2.0.1</version>
            </dependency>
            <dependency>
